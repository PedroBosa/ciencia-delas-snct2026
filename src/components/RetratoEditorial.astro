---
import { iniciais, type Pesquisadora } from '../data/pesquisadoras';

interface Props {
  pesquisadora: Pesquisadora;
  prioridade?: boolean;
}

const { pesquisadora: p, prioridade = false } = Astro.props;
const letras = iniciais(p);
---

<figure class:list={['retrato', `retrato-${p.escopo}`]}>
  <div class="retrato-quadro">
    {
      p.foto ? (
        <img
          src={p.foto}
          alt={`Retrato de ${p.nome}, ${p.instituicao}.`}
          width="640"
          height="800"
          loading={prioridade ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div
          class="retrato-iniciais"
          role="img"
          aria-label={`Monograma tipográfico de ${p.nome}`}
        >
          <span class="iniciais" aria-hidden="true">{letras}</span>
          <span class="mono instituicao-selo">{p.instituicaoSigla}</span>
        </div>
      )
    }
  </div>

  {p.foto && p.fotoCredito && <figcaption class="meta legenda-retrato">{p.fotoCredito}</figcaption>}
</figure>

<style>
  .retrato {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
  }

  .legenda-retrato {
    font-size: 0.7rem;
    line-height: 1.3;
  }

  .retrato-nordeste {
    --cor-escopo: var(--magenta);
  }
  .retrato-brasil {
    --cor-escopo: var(--lima);
  }
  .retrato-internacional {
    --cor-escopo: var(--ciano);
  }

  .retrato-quadro {
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--borda-forte);
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 0 6px 20px -6px rgba(49, 35, 107, 0.12);
    overflow: hidden;
  }

  .retrato-quadro img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .retrato-iniciais {
    width: 100%;
    height: 100%;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    background: var(--bg-lavanda);
  }

  .iniciais {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(2.3rem, 5vw, 4.1rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--violeta);
    margin-top: auto;
    user-select: none;
  }

  .instituicao-selo {
    font-size: var(--t-xs);
    color: var(--ink-2);
    margin-top: auto;
  }
</style>
