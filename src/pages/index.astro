---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapaBrasil from '../components/MapaBrasil.astro';
import {
  AREAS,
  UFS,
  contarPorUF,
  iniciais,
  miniatura,
  pesquisadoras,
  type Area,
  type UF,
} from '../data/pesquisadoras';
import { iniciativas } from '../data/iniciativas';
import { cordoes, palavrasVerticais, paraBinario } from '../lib/binario';

const contagemUF = contarPorUF();
const listaUfs = Object.entries(UFS) as [UF, (typeof UFS)[UF]][];
const ufsNordeste: UF[] = ['PE', 'BA', 'PB', 'CE', 'RN', 'SE', 'AL', 'PI', 'MA'];
const outrasUfsComPerfis = listaUfs
  .map(([sigla]) => sigla)
  .filter((sigla) => UFS[sigla].regiao !== 'nordeste' && (contagemUF[sigla] ?? 0) > 0)
  .sort((a, b) => (contagemUF[b] ?? 0) - (contagemUF[a] ?? 0));

const totalPerfis = pesquisadoras.length;
const totalNordeste = pesquisadoras.filter((p) => p.escopo === 'nordeste').length;
const totalBrasilOutras = pesquisadoras.filter((p) => p.escopo === 'brasil').length;
const totalInternacional = pesquisadoras.filter((p) => p.escopo === 'internacional').length;

const listaAreas = (Object.entries(AREAS) as [Area, (typeof AREAS)[Area]][]).map(([chave, info]) => ({
  chave,
  ...info,
  qtd: pesquisadoras.filter((p) => p.area === chave).length,
}));

const cordoesTabela = cordoes.map((palavra) => ({
  palavra,
  binario: paraBinario(palavra).join(' '),
}));

const slugsMosaicoHero = [
  'ada-lovelace',
  'grace-hopper',
  'katherine-johnson',
  'teresa-ludermir',
  'juliana-carvalho',
  'sophie-wilson',
  'margaret-hamilton',
  'hedy-lamarr',
  'karen-sparck-jones',
  'rossana-andrade',
  'nina-silva',
  'francilene-garcia',
  'joan-clarke',
  'radia-perlman',
  'frances-allen',
  'ana-carolina-salgado',
  'thais-batista',
  'vaninha-vieira',
  'barbara-liskov',
  'shafi-goldwasser',
  'timnit-gebru',
  'rita-suzana-maciel',
  'karin-breitman',
  'camila-achutti',
];
const mosaicoHero = slugsMosaicoHero
  .map((slug) => pesquisadoras.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const todasFotosMosaico = Array.from(
  new Set(pesquisadoras.map((p) => miniatura(p) ?? p.foto).filter((f): f is string => Boolean(f)))
);
---

<BaseLayout titulo="Ciência Delas · 23ª SNCT 2026">
  <!-- 1. Abertura em tela cheia com mosaico dinâmico ao fundo e degradê roxo da esquerda para a direita -->
  <section class="faixa-hero" id="secao-hero" aria-labelledby="titulo-exposicao">
    <div class="hero-fundo" aria-hidden="true">
      <div
        class="hero-mosaico-fundo"
        id="mosaico-hero"
        data-fotos={JSON.stringify(todasFotosMosaico)}
      >
        {
          mosaicoHero.map((p) => {
            const fotoInicial = miniatura(p) ?? p.foto ?? '';
            return (
              <div class="slot-mosaico">
                <div class="cartao-mosaico" data-foto-atual={fotoInicial}>
                  <div class="face-mosaico face-frente">
                    <img src={fotoInicial} alt="" width="160" height="200" decoding="async" />
                  </div>
                  <div class="face-mosaico face-verso">
                    <img src={fotoInicial} alt="" width="160" height="200" decoding="async" />
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
      <div class="hero-degrade-roxo"></div>
    </div>

    <div class="wrap grade-hero">
      <div class="hero-conteudo">
        <p class="hero-selo">23ª SNCT 2026 · TADS · IFPI Campus Floriano</p>
        <h1 id="titulo-exposicao" class="hero-titulo">
          Ciência <span class="hero-destaque">Delas</span>
        </h1>
        <p class="hero-mote">A ciência é delas, é com elas, e é para todos nós.</p>

        <p class="hero-texto">
          Dos primeiros algoritmos do século XIX aos laboratórios das universidades públicas do
          Nordeste: conheça a história e o trabalho de {totalPerfis} mulheres que ajudaram a criar a
          computação e fazem ciência no Brasil hoje.
        </p>

        <div class="hero-acoes">
          <a href="#mural" class="botao-amarelo botao-hero-principal">Conhecer as pesquisadoras</a>
          <a href="/linha-do-tempo" class="botao-hero-contorno">Ver linha do tempo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Mural de Pesquisadoras (#F7F5FC Lavanda Suave) -->
  <section id="mural" class="faixa-lavanda secao-espacada" aria-labelledby="titulo-mural">
    <div class="wrap">
      <div class="cabecalho-secao">
        <h2 id="titulo-mural" class="titulo-secao filete-magenta">Pesquisadoras</h2>
      </div>

      <!-- Mapa por estado (aberto no desktop, recolhido em 1 toque no celular) -->
      <details class="gaveta-mapa" id="gaveta-mapa" open>
        <summary class="resumo-gaveta">
          <span>Filtrar pelo mapa do Brasil e do Nordeste</span>
          <span class="meta estado-gaveta" aria-hidden="true">Mapa</span>
        </summary>

        <div class="bloco-geografico">
          <div class="coluna-mapa">
            <MapaBrasil contagemUF={contagemUF} />
            <p class="legenda-mapa meta">
              <span><i class="amostra amostra-ne" aria-hidden="true"></i> Nordeste</span>
              <span><i class="amostra amostra-br" aria-hidden="true"></i> Outras regiões</span>
              <span><i class="amostra amostra-vazia" aria-hidden="true"></i> Sem perfis listados</span>
            </p>
          </div>

          <div class="coluna-nordeste">
            <p class="subtitulo-ne">Os nove estados do Nordeste</p>
            <ul role="list" class="lista-ne">
              {
                ufsNordeste.map((sigla) => {
                  const qtd = contagemUF[sigla] ?? 0;
                  return (
                    <li>
                      <button type="button" class="item-ne" data-uf={sigla} aria-pressed="false">
                        <span class="mono sigla-ne">{sigla}</span>
                        <span class="nome-ne">{UFS[sigla].nome}</span>
                        <span class="mono qtd-ne">{qtd}</span>
                      </button>
                    </li>
                  );
                })
              }
            </ul>

            <p class="subtitulo-ne subtitulo-outras">Outras unidades da federação</p>
            <ul role="list" class="lista-ne">
              {
                outrasUfsComPerfis.map((sigla) => {
                  const qtd = contagemUF[sigla] ?? 0;
                  return (
                    <li>
                      <button type="button" class="item-ne item-br" data-uf={sigla} aria-pressed="false">
                        <span class="mono sigla-ne sigla-br">{sigla}</span>
                        <span class="nome-ne">{UFS[sigla].nome}</span>
                        <span class="mono qtd-ne">{qtd}</span>
                      </button>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </div>
      </details>

      <!-- Barra de filtros enxuta e perfeitamente alinhada -->
      <div class="barra-filtros" role="region" aria-label="Filtros">
        <div class="abas abas-mural" role="group" aria-label="Origem">
          <button type="button" class="aba" data-escopo-btn="todas" aria-pressed="true">
            Todas <span class="qtd">{totalPerfis}</span>
          </button>
          <button type="button" class="aba" data-escopo-btn="nordeste" aria-pressed="false">
            Nordeste <span class="qtd">{totalNordeste}</span>
          </button>
          <button type="button" class="aba" data-escopo-btn="brasil" aria-pressed="false">
            Outras regiões <span class="qtd">{totalBrasilOutras}</span>
          </button>
          <button type="button" class="aba" data-escopo-btn="internacional" aria-pressed="false">
            Pioneiras mundiais <span class="qtd">{totalInternacional}</span>
          </button>
        </div>

        <div class="controles-direitos">
          <!-- Seletor customizado de Estado (alinhamento vertical garantido) -->
          <div class="menu-filtro" id="menu-uf">
            <button
              type="button"
              class="gatilho-filtro"
              id="gatilho-uf"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span class="rotulo-gatilho" id="rotulo-uf">Estado</span>
              <svg class="icone-seta" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                <path
                  d="M3.5 5.25L7 8.75l3.5-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.65"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>

            <div class="painel-opcoes" role="listbox" aria-label="Escolher estado" hidden>
              <button type="button" role="option" class="opcao-filtro" data-opcao-uf="" data-rotulo="Estado" aria-selected="true">
                Todos os estados
              </button>
              <p class="grupo-opcoes">Nordeste</p>
              {
                ufsNordeste.map((uf) => (
                  <button
                    type="button"
                    role="option"
                    class="opcao-filtro"
                    data-opcao-uf={uf}
                    data-rotulo={UFS[uf].nome}
                    aria-selected="false"
                  >
                    <span>{UFS[uf].nome}</span>
                    <span class="mono qtd-opcao">{contagemUF[uf]}</span>
                  </button>
                ))
              }
              <p class="grupo-opcoes">Outras regiões</p>
              {
                outrasUfsComPerfis.map((uf) => (
                  <button
                    type="button"
                    role="option"
                    class="opcao-filtro"
                    data-opcao-uf={uf}
                    data-rotulo={UFS[uf].nome}
                    aria-selected="false"
                  >
                    <span>{UFS[uf].nome}</span>
                    <span class="mono qtd-opcao">{contagemUF[uf]}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <!-- Seletor customizado de Área (alinhamento vertical garantido) -->
          <div class="menu-filtro" id="menu-area">
            <button
              type="button"
              class="gatilho-filtro"
              id="gatilho-area"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span class="rotulo-gatilho" id="rotulo-area">Área</span>
              <svg class="icone-seta" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                <path
                  d="M3.5 5.25L7 8.75l3.5-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.65"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>

            <div class="painel-opcoes painel-opcoes-largo" role="listbox" aria-label="Escolher área" hidden>
              <button type="button" role="option" class="opcao-filtro" data-opcao-area="todas" data-rotulo="Área" aria-selected="true">
                Todas as áreas
              </button>
              {
                listaAreas.map((a) => (
                  <button
                    type="button"
                    role="option"
                    class="opcao-filtro"
                    data-opcao-area={a.chave}
                    data-rotulo={a.curto}
                    aria-selected="false"
                  >
                    <span>{a.curto}</span>
                    <span class="mono qtd-opcao">{a.qtd}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <label for="busca-catalogo" class="sr-only">Buscar</label>
          <input
            id="busca-catalogo"
            type="search"
            placeholder="Buscar nome ou universidade"
            class="campo campo-busca"
            autocomplete="off"
          />
        </div>
      </div>

      <div class="linha-contagem">
        <p class="meta" id="status-catalogo" aria-live="polite">
          Mostrando todas as {totalPerfis} pesquisadoras
        </p>
        <div class="acoes-contagem" id="acoes-contagem" hidden>
          <button type="button" class="botao-texto" id="btn-copiar-filtro">
            Copiar link do filtro
          </button>
          <span class="meta sep-contagem" aria-hidden="true">·</span>
          <button type="button" class="botao-texto" id="btn-limpar-filtros">
            Limpar filtros
          </button>
        </div>
      </div>

      <!-- Grade estruturada de cartões -->
      <ol role="list" class="grade-mural" id="lista-pesquisadoras">
        {
          pesquisadoras.map((p) => (
            <li
              class:list={['item-mural', `mural-${p.escopo}`]}
              data-escopo={p.escopo}
              data-area={p.area}
              data-uf={p.uf ?? ''}
              data-busca={`${p.nome} ${p.nomeCurto} ${p.estadoOuPais} ${p.uf ?? ''} ${p.instituicao} ${p.instituicaoSigla} ${p.campo} ${p.resumoCurto} ${p.contribuicaoPratica}`.toLowerCase()}
            >
              <a href={`/pesquisadoras/${p.slug}`} class="cartao-pesquisadora">
                <div class="cartao-cabecalho">
                  {p.foto ? (
                    <span class="moldura-avatar">
                      <img
                        src={miniatura(p) ?? p.foto}
                        alt=""
                        width="76"
                        height="95"
                        class="avatar-foto"
                      />
                    </span>
                  ) : (
                    <span class="avatar-iniciais" aria-hidden="true">{iniciais(p)}</span>
                  )}
                  <div class="cartao-identificacao">
                    <p class="cartao-origem">
                      {p.estadoOuPais} <span class="sep-origem" aria-hidden="true">·</span>{' '}
                      <span class="mono">{p.instituicaoSigla}</span>
                    </p>
                    <h3 class="cartao-nome">{p.nomeCurto}</h3>
                    <p class="cartao-area">{AREAS[p.area].curto}</p>
                  </div>
                </div>

                <p class="cartao-resumo">{p.contribuicaoPratica}</p>

                <div class="cartao-rodape">
                  <span class="ler-mais">
                    <span>Ler história</span>
                    <svg class="seta-ler" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                      <path
                        d="M3.5 8h9M8.5 4l4 4-4 4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.65"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>

      <div id="vazio-catalogo" class="estado-vazio" hidden>
        <p>Nenhuma pesquisadora encontrada com esses filtros.</p>
        <button type="button" class="botao-texto" id="btn-reset-vazio">
          Mostrar todas as {totalPerfis} pesquisadoras
        </button>
      </div>
    </div>
  </section>

  <!-- 3. Código Binário (#FFFFFF) -->
  <section id="binarios" class="faixa-branca secao-espacada" aria-labelledby="titulo-binarios">
    <div class="wrap">
      <div class="cabecalho-secao">
        <div>
          <h2 id="titulo-binarios" class="titulo-secao filete-ciano">Código binário</h2>
          <p class="subtitulo-secao">
            Na representação binária, cada letra ou algarismo equivale a uma sequência de oito zeros
            e uns.
          </p>
        </div>
      </div>

      <div class="grade-binarios">
        <div>
          <h3 class="subtitulo-bloco">Siglas em binário</h3>
          <dl class="tabela-binarios">
            {
              cordoesTabela.map((c) => (
                <div class="linha-binario">
                  <dt class="mono palavra-bin">{c.palavra}</dt>
                  <dd class="mono codigo-bin">{c.binario}</dd>
                </div>
              ))
            }
          </dl>

          <h3 class="subtitulo-bloco rotulo-espacado">Palavras-chave</h3>
          <ul role="list" class="lista-palavras">
            {palavrasVerticais.map((palavra) => (
              <li class="mono tag-palavra">{palavra}</li>
            ))}
          </ul>
        </div>

        <div class="painel-conversor">
          <label for="input-binario" class="subtitulo-bloco">Escreva uma palavra em binário</label>
          <p class="meta texto-conversor">
            Digite seu nome ou uma sigla (até 12 caracteres) para converter letra por letra.
          </p>
          <input
            id="input-binario"
            type="text"
            maxlength="12"
            value="ELAS"
            placeholder="Ex.: MARIA"
            class="campo mono campo-conversor"
            autocomplete="off"
          />

          <dl class="resultado-bytes" id="resultado-bytes" aria-live="polite">
            {
              [...'ELAS'].map((ch) => (
                <div class="par-byte">
                  <dt class="mono letra-byte">{ch}</dt>
                  <dd class="mono bits-byte">{ch.charCodeAt(0).toString(2).padStart(8, '0')}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Grupos e Projetos pelo Brasil (#F7F5FC) -->
  <section id="iniciativas" class="faixa-lavanda secao-espacada" aria-labelledby="titulo-programas">
    <div class="wrap">
      <div class="cabecalho-secao">
        <div>
          <h2 id="titulo-programas" class="titulo-secao filete-lima">
            Grupos e projetos pelo Brasil
          </h2>
          <p class="subtitulo-secao">
            Coletivos de estudantes e programas universitários que promovem oficinas, encontros e
            apoio a meninas na computação.
          </p>
        </div>
      </div>

      <ul role="list" class="grade-programas">
        {
          iniciativas.map((ini) => (
            <li class="cartao-programa">
              <h3>{ini.nome}</h3>
              <p class="meta vinculo-programa">{ini.vinculo} · {ini.local}</p>
              <p class="desc-programa">{ini.descricao}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  let escopoAtivo = 'todas';
  let areaAtiva = 'todas';
  let ufAtiva = '';
  let termoBusca = '';

  const itens = document.querySelectorAll<HTMLLIElement>('.item-mural');
  const botoesEscopo = document.querySelectorAll<HTMLButtonElement>('[data-escopo-btn]');
  const elementosUf = document.querySelectorAll<HTMLElement | SVGGElement>('#gaveta-mapa [data-uf]');
  const botoesUf = document.querySelectorAll<HTMLElement | SVGGElement>(
    '#gaveta-mapa .alvo-uf, #gaveta-mapa .item-ne'
  );
  const inputBusca = document.getElementById('busca-catalogo') as HTMLInputElement | null;
  const statusEl = document.getElementById('status-catalogo');
  const acoesContagem = document.getElementById('acoes-contagem');
  const btnCopiarFiltro = document.getElementById('btn-copiar-filtro') as HTMLButtonElement | null;
  const btnLimpar = document.getElementById('btn-limpar-filtros') as HTMLButtonElement | null;
  const blocoVazio = document.getElementById('vazio-catalogo');
  const btnResetVazio = document.getElementById('btn-reset-vazio');

  // Menus customizados de Estado e Área
  const menuUf = document.getElementById('menu-uf');
  const gatilhoUf = document.getElementById('gatilho-uf') as HTMLButtonElement | null;
  const rotuloUf = document.getElementById('rotulo-uf');
  const opcoesUf = document.querySelectorAll<HTMLButtonElement>('[data-opcao-uf]');

  const menuArea = document.getElementById('menu-area');
  const gatilhoArea = document.getElementById('gatilho-area') as HTMLButtonElement | null;
  const rotuloArea = document.getElementById('rotulo-area');
  const opcoesArea = document.querySelectorAll<HTMLButtonElement>('[data-opcao-area]');

  function fecharMenus() {
    [menuUf, menuArea].forEach((m) => {
      if (!m) return;
      const btn = m.querySelector<HTMLButtonElement>('.gatilho-filtro');
      const painel = m.querySelector<HTMLElement>('.painel-opcoes');
      btn?.setAttribute('aria-expanded', 'false');
      if (painel) painel.hidden = true;
    });
  }

  function alternarMenu(menu: HTMLElement | null) {
    if (!menu) return;
    const btn = menu.querySelector<HTMLButtonElement>('.gatilho-filtro');
    const painel = menu.querySelector<HTMLElement>('.painel-opcoes');
    const aberto = btn?.getAttribute('aria-expanded') === 'true';
    fecharMenus();
    if (!aberto && btn && painel) {
      btn.setAttribute('aria-expanded', 'true');
      painel.hidden = false;
    }
  }

  gatilhoUf?.addEventListener('click', (e) => {
    e.stopPropagation();
    alternarMenu(menuUf);
  });

  gatilhoArea?.addEventListener('click', (e) => {
    e.stopPropagation();
    alternarMenu(menuArea);
  });

  document.addEventListener('click', (e) => {
    const alvo = e.target as Node;
    if (!menuUf?.contains(alvo) && !menuArea?.contains(alvo)) {
      fecharMenus();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') fecharMenus();
  });

  const total = itens.length;
  const gavetaMapa = document.getElementById('gaveta-mapa') as HTMLDetailsElement | null;
  if (gavetaMapa && window.matchMedia('(max-width: 859px)').matches) {
    gavetaMapa.open = false;
  }
  window.matchMedia('(min-width: 860px)').addEventListener('change', (ev) => {
    if (gavetaMapa && ev.matches) gavetaMapa.open = true;
  });

  function normalizar(str: string): string {
    return str
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  const escoposValidos = new Set(
    Array.from(botoesEscopo)
      .map((b) => b.dataset.escopoBtn)
      .filter((v): v is string => Boolean(v))
  );
  const ufsValidas = new Set(
    Array.from(opcoesUf)
      .map((op) => op.dataset.opcaoUf)
      .filter((v): v is string => Boolean(v))
  );
  const areasValidas = new Set(
    Array.from(opcoesArea)
      .map((op) => op.dataset.opcaoArea)
      .filter((v): v is string => Boolean(v && v !== 'todas'))
  );

  function sincronizarEscopoUi() {
    botoesEscopo.forEach((b) =>
      b.setAttribute('aria-pressed', String((b.dataset.escopoBtn ?? 'todas') === escopoAtivo))
    );
  }

  function sincronizarUfUi() {
    elementosUf.forEach((el) =>
      el.setAttribute('aria-pressed', String(Boolean(ufAtiva) && el.dataset.uf === ufAtiva))
    );
    let textoUf = 'Estado';
    opcoesUf.forEach((op) => {
      const selecionada = (op.dataset.opcaoUf ?? '') === ufAtiva;
      op.setAttribute('aria-selected', String(selecionada));
      if (selecionada && ufAtiva) textoUf = op.dataset.rotulo ?? ufAtiva;
    });
    if (rotuloUf) rotuloUf.textContent = textoUf;
    gatilhoUf?.classList.toggle('ativo', Boolean(ufAtiva));
  }

  function sincronizarAreaUi() {
    let textoArea = 'Área';
    opcoesArea.forEach((op) => {
      const selecionada = (op.dataset.opcaoArea ?? 'todas') === areaAtiva;
      op.setAttribute('aria-selected', String(selecionada));
      if (selecionada && areaAtiva !== 'todas') textoArea = op.dataset.rotulo ?? 'Área';
    });
    if (rotuloArea) rotuloArea.textContent = textoArea;
    gatilhoArea?.classList.toggle('ativo', areaAtiva !== 'todas');
  }

  function construirQueryFiltros(): string {
    const params = new URLSearchParams();
    if (escopoAtivo !== 'todas') params.set('escopo', escopoAtivo);
    if (ufAtiva) params.set('uf', ufAtiva);
    if (areaAtiva !== 'todas') params.set('area', areaAtiva);
    const buscaLimpa = termoBusca.trim();
    if (buscaLimpa) params.set('busca', buscaLimpa);
    return params.toString();
  }

  function sincronizarUrl() {
    const qs = construirQueryFiltros();
    const destino = `${window.location.pathname}${qs ? `?${qs}` : ''}${window.location.hash}`;
    const atual = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (destino !== atual) {
      window.history.replaceState(null, '', destino);
    }
  }

  function aplicarFiltros(opcoes?: { atualizarUrl?: boolean }) {
    const q = normalizar(termoBusca.trim());
    let visiveis = 0;

    itens.forEach((li) => {
      const okEscopo = escopoAtivo === 'todas' || li.dataset.escopo === escopoAtivo;
      const okArea = areaAtiva === 'todas' || li.dataset.area === areaAtiva;
      const okUf = !ufAtiva || li.dataset.uf === ufAtiva;
      const okBusca = !q || normalizar(li.dataset.busca ?? '').includes(q);

      const mostrar = okEscopo && okArea && okUf && okBusca;
      li.hidden = !mostrar;
      if (mostrar) visiveis++;
    });

    const temFiltro =
      escopoAtivo !== 'todas' || areaAtiva !== 'todas' || Boolean(ufAtiva) || Boolean(q);

    if (acoesContagem) acoesContagem.hidden = !temFiltro;
    if (blocoVazio) blocoVazio.hidden = visiveis > 0;

    if (statusEl) {
      statusEl.textContent = temFiltro
        ? `${visiveis} ${visiveis === 1 ? 'pesquisadora encontrada' : 'pesquisadoras encontradas'}${ufAtiva ? ` (${ufAtiva})` : ''}`
        : `Mostrando todas as ${total} pesquisadoras`;
    }

    if (opcoes?.atualizarUrl !== false) {
      sincronizarUrl();
    }
  }

  function selecionarUf(novaUf: string) {
    ufAtiva = novaUf;
    if (ufAtiva) {
      escopoAtivo = 'todas';
      sincronizarEscopoUi();
    }
    sincronizarUfUi();
    aplicarFiltros();
  }

  function carregarEstadoDaUrl() {
    const params = new URLSearchParams(window.location.search);
    const escopoUrl = (params.get('escopo') ?? '').toLowerCase();
    const ufUrl = (params.get('uf') ?? '').toUpperCase();
    const areaUrl = (params.get('area') ?? '').toLowerCase();
    const buscaUrl = params.get('busca') ?? params.get('q') ?? '';

    ufAtiva = ufsValidas.has(ufUrl) ? ufUrl : '';
    escopoAtivo = !ufAtiva && escoposValidos.has(escopoUrl) ? escopoUrl : 'todas';
    areaAtiva = areasValidas.has(areaUrl) ? areaUrl : 'todas';
    termoBusca = buscaUrl;
    if (inputBusca) inputBusca.value = termoBusca;

    sincronizarEscopoUi();
    sincronizarUfUi();
    sincronizarAreaUi();
    aplicarFiltros({ atualizarUrl: false });
  }

  botoesEscopo.forEach((btn) => {
    btn.addEventListener('click', () => {
      escopoAtivo = btn.dataset.escopoBtn ?? 'todas';
      ufAtiva = '';
      sincronizarEscopoUi();
      sincronizarUfUi();
      aplicarFiltros();
    });
  });

  botoesUf.forEach((btn) => {
    btn.addEventListener('click', () => {
      const clicada = btn.dataset.uf ?? '';
      selecionarUf(ufAtiva === clicada ? '' : clicada);
    });
  });

  opcoesUf.forEach((op) => {
    op.addEventListener('click', () => {
      selecionarUf(op.dataset.opcaoUf ?? '');
      fecharMenus();
    });
  });

  opcoesArea.forEach((op) => {
    op.addEventListener('click', () => {
      areaAtiva = op.dataset.opcaoArea ?? 'todas';
      sincronizarAreaUi();
      fecharMenus();
      aplicarFiltros();
    });
  });

  inputBusca?.addEventListener('input', () => {
    termoBusca = inputBusca.value;
    aplicarFiltros();
  });

  let timerCopiaFiltro = 0;
  btnCopiarFiltro?.addEventListener('click', async () => {
    const qs = construirQueryFiltros();
    const linkFiltro = `${window.location.origin}${window.location.pathname}${qs ? `?${qs}` : ''}#mural`;
    if (!btnCopiarFiltro.dataset.rotuloOrig) {
      btnCopiarFiltro.dataset.rotuloOrig = btnCopiarFiltro.textContent?.trim() ?? '';
    }
    try {
      await navigator.clipboard.writeText(linkFiltro);
      window.clearTimeout(timerCopiaFiltro);
      btnCopiarFiltro.textContent = 'Link copiado';
      timerCopiaFiltro = window.setTimeout(() => {
        btnCopiarFiltro.textContent = btnCopiarFiltro.dataset.rotuloOrig ?? 'Copiar link do filtro';
      }, 1600);
    } catch {
      btnCopiarFiltro.textContent = 'Copie pela barra do navegador';
    }
  });

  function limparTudo() {
    escopoAtivo = 'todas';
    areaAtiva = 'todas';
    ufAtiva = '';
    termoBusca = '';
    if (inputBusca) inputBusca.value = '';
    sincronizarEscopoUi();
    sincronizarUfUi();
    sincronizarAreaUi();
    aplicarFiltros();
  }

  btnLimpar?.addEventListener('click', limparTudo);
  btnResetVazio?.addEventListener('click', limparTudo);

  carregarEstadoDaUrl();
  window.addEventListener('popstate', carregarEstadoDaUrl);
  window.addEventListener('pageshow', (ev) => {
    if (ev.persisted) carregarEstadoDaUrl();
  });

  // Conversor binário
  const inputBin = document.getElementById('input-binario') as HTMLInputElement | null;
  const dlBytes = document.getElementById('resultado-bytes');

  inputBin?.addEventListener('input', () => {
    const limpo = inputBin.value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^\x20-\x7E]/g, '')
      .slice(0, 12);

    const texto = limpo || 'ELAS';
    if (dlBytes) {
      dlBytes.innerHTML = [...texto]
        .map((ch) => {
          const rotulo = ch === ' ' ? 'espaço' : ch;
          const bits = ch.charCodeAt(0).toString(2).padStart(8, '0');
          return `<div class="par-byte"><dt class="mono letra-byte">${rotulo}</dt><dd class="mono bits-byte">${bits}</dd></div>`;
        })
        .join('');
    }
  });

  // Rotação 3D simultânea no mosaico do Hero, evitando células próximas
  const secaoHero = document.getElementById('secao-hero');
  const mosaicoEl = document.getElementById('mosaico-hero');

  if (secaoHero && mosaicoEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const todasFotos: string[] = JSON.parse(mosaicoEl.dataset.fotos ?? '[]');
    const cartoes = Array.from(mosaicoEl.querySelectorAll<HTMLElement>('.cartao-mosaico'));

    if (cartoes.length > 0 && todasFotos.length > cartoes.length) {
      const mqDesktop = window.matchMedia('(min-width: 760px)');
      const passos = new Array<number>(cartoes.length).fill(0);
      const girando = new Set<number>();
      const historicoRecente: number[] = [];
      const emUso = new Set<string>();

      cartoes.forEach((c) => {
        if (c.dataset.fotoAtual) emUso.add(c.dataset.fotoAtual);
      });

      const filaReserva = todasFotos.filter((f) => !emUso.has(f));
      for (let i = filaReserva.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [filaReserva[i], filaReserva[j]] = [filaReserva[j], filaReserva[i]];
      }

      let heroVisivel = true;
      let timerProximo = 0;

      const coordenadasSlot = (idx: number) => {
        const colunas = mqDesktop.matches ? 6 : 4;
        return { col: idx % colunas, lin: Math.floor(idx / colunas) };
      };

      const estaProximo = (a: number, b: number, distManhattanMin: number): boolean => {
        const ca = coordenadasSlot(a);
        const cb = coordenadasSlot(b);
        const dx = Math.abs(ca.col - cb.col);
        const dy = Math.abs(ca.lin - cb.lin);
        // Bloqueia todos os 8 vizinhos imediatos (horizontal, vertical e diagonal)
        if (Math.max(dx, dy) <= 1) return true;
        return dx + dy < distManhattanMin;
      };

      const escolherSlot = (extrasBloqueados: number[]): number => {
        const ehDesktop = mqDesktop.matches;
        const ativos = new Set<number>([...girando, ...extrasBloqueados]);

        const buscar = (distManhattanMin: number, apenasColsVisiveis: boolean) => {
          const candidatos: number[] = [];
          for (let i = 0; i < cartoes.length; i++) {
            if (ativos.has(i) || historicoRecente.includes(i)) continue;
            const { col } = coordenadasSlot(i);
            // Coluna 0 fica quase oculta sob o degradê sólido da esquerda
            if (col === 0) continue;
            if (apenasColsVisiveis && ehDesktop && col === 1) continue;

            let proximo = false;
            for (const outro of ativos) {
              if (estaProximo(i, outro, distManhattanMin)) {
                proximo = true;
                break;
              }
            }
            if (!proximo) candidatos.push(i);
          }
          return candidatos;
        };

        let candidatos = buscar(3, true);
        if (candidatos.length === 0) candidatos = buscar(3, false);
        if (candidatos.length === 0) candidatos = buscar(2, false);
        if (candidatos.length === 0) return -1;

        return candidatos[Math.floor(Math.random() * candidatos.length)];
      };

      const virarSlot = async (idx: number, atrasoMs = 0) => {
        if (idx < 0 || girando.has(idx) || filaReserva.length === 0) return;

        const cartao = cartoes[idx];
        const novaFoto = filaReserva.shift();
        if (!novaFoto) return;

        girando.add(idx);
        emUso.add(novaFoto);
        historicoRecente.push(idx);
        while (historicoRecente.length > 6) historicoRecente.shift();

        const esperar =
          atrasoMs > 0
            ? new Promise<void>((resolve) => window.setTimeout(resolve, atrasoMs))
            : Promise.resolve();

        const imgOculta = cartao.querySelector<HTMLImageElement>(
          passos[idx] % 2 === 0 ? '.face-verso img' : '.face-frente img'
        );

        const decodificar = imgOculta
          ? (() => {
              imgOculta.src = novaFoto;
              return imgOculta.decode().catch(() => {
                // Prossegue mesmo se o navegador já tiver decodificado em cache
              });
            })()
          : Promise.resolve();

        await Promise.all([decodificar, esperar]);

        const fotoAntiga = cartao.dataset.fotoAtual ?? '';
        cartao.dataset.fotoAtual = novaFoto;
        passos[idx] += 1;
        const angulo = passos[idx] * 180;
        window.requestAnimationFrame(() => {
          cartao.style.transform = `rotateY(${angulo}deg)`;
        });

        window.setTimeout(() => {
          if (fotoAntiga && fotoAntiga !== novaFoto) {
            emUso.delete(fotoAntiga);
            // Reinsere no fim da fila com leve variação para nunca repetir padrão fixo
            const cauda = Math.max(0, filaReserva.length - Math.floor(Math.random() * 6));
            filaReserva.splice(cauda, 0, fotoAntiga);
          }
          girando.delete(idx);
        }, 860);
      };

      const dispararOnda = () => {
        const alvo = mqDesktop.matches ? (Math.random() < 0.45 ? 4 : 3) : 2;
        const faltam = Math.max(0, alvo - girando.size);
        const escolhidos: number[] = [];

        for (let k = 0; k < faltam; k++) {
          const idx = escolherSlot(escolhidos);
          if (idx < 0) break;
          escolhidos.push(idx);
          void virarSlot(idx, k * 95);
        }
      };

      const agendarCiclo = (atraso = 1150) => {
        window.clearTimeout(timerProximo);
        if (!heroVisivel || document.hidden) return;

        timerProximo = window.setTimeout(() => {
          if (heroVisivel && !document.hidden) {
            dispararOnda();
            agendarCiclo(1050 + Math.floor(Math.random() * 350));
          }
        }, atraso);
      };

      const observador = new IntersectionObserver(
        (entradas) => {
          heroVisivel = Boolean(entradas[0]?.isIntersecting);
          if (heroVisivel && !document.hidden) {
            agendarCiclo(400);
          } else {
            window.clearTimeout(timerProximo);
          }
        },
        { threshold: 0.08 }
      );

      observador.observe(secaoHero);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          window.clearTimeout(timerProximo);
        } else if (heroVisivel) {
          agendarCiclo(450);
        }
      });
    }
  }
</script>

